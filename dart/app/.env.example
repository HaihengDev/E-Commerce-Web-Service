# Local service ports
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CATEGORY_SERVICE_PORT=8082
MERCHANT_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085
PRODUCT_SERVICE_PORT=8086

# Local host URLs used when the Dart services run outside Docker.
AUTH_SERVICE_URL=http://localhost:8081
CATEGORY_SERVICE_URL=http://localhost:8082/categories
MERCHANT_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084/orders
PAYMENT_SERVICE_URL=http://localhost:8085
PRODUCT_SERVICE_URL=http://localhost:8086

# Local MongoDB and Redis containers (see docker-compose.yml).
MONGO_URI_AUTH_SERVICE=mongodb://localhost:27017/ecommerce_auth
MONGO_URI_PRODUCT_SERVICE=mongodb://localhost:27017/ecommerce_products
MONGO_URI_CATEGORY_SERVICE=mongodb://localhost:27017/ecommerce_categories
MONGO_URI_ORDER_SERVICE=mongodb://localhost:27017/ecommerce_orders
REDIS_URL=redis://localhost:6379

# Replace with a private random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INTERNAL_SERVICE_TOKEN=replace-with-a-different-random-secret-of-at-least-32-characters

# Optional payment-provider sandbox credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Allows simulated payments for local demos only; it does not charge money.
PAYMENT_DEMO_MODE=true
